// One database per service (rule 2). This schema is Directory's alone.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DIRECTORY_DATABASE_URL")
}

// Ids are client-supplied UUIDs (decided this phase — slice 4's events carry
// them, and offline clients must mint their own). createdAt is recorded now so
// those same events can carry an occurrence time without a retrofit.
model Classroom {
  id          String       @id
  name        String
  capacity    Int
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
}

model Child {
  id         String      @id
  firstName  String
  lastName   String
  createdAt  DateTime    @default(now())
  enrollment Enrollment?
}

model Staff {
  id        String   @id
  firstName String
  lastName  String
  role      String
  createdAt DateTime @default(now())
}

// A child's placement in one classroom. Capacity is NOT enforced here in
// Prisma or service code — a BEFORE INSERT trigger (migration
// 0002_add_enrollment_capacity_constraint) locks the classroom row and counts,
// so two concurrent enrollments at the limit can't both win (rule: DB-side
// constraint). A child holds at most one placement: unique childId.
model Enrollment {
  id          String   @id
  childId     String   @unique
  classroomId String
  createdAt   DateTime @default(now())

  child     Child     @relation(fields: [childId], references: [id])
  classroom Classroom @relation(fields: [classroomId], references: [id])
}

// Transactional outbox (rule: a write must never commit without its event). A
// domain write and its event row are inserted in ONE transaction, so a rollback
// (e.g. the capacity trigger) leaves no event. The publisher loop drains unsent
// rows to Kafka and stamps sentAt only after the broker acks — at-least-once,
// since a crash between ack and stamp re-sends (the consumer is idempotent).
// occurredAt is the authoritative occurrence time the event carries.
model OutboxEvent {
  id         String    @id
  topic      String
  key        String
  payload    Json
  occurredAt DateTime  @default(now())
  sentAt     DateTime?

  @@index([sentAt, occurredAt])
}
